# api/.htaccess — JSON API front controller (Nov 2026)
# Serves both https://api.batcaveroadfarm.com/v1/...  (subdomain; document root = this folder)
#        and  https://batcaveroadfarm.com/api/v1/...  (same code on the main domain, for the admin)
# This folder has its own RewriteEngine, so the main site's rewrite rules (HTTPS, trailing slash)
# do NOT apply here — HTTPS is forced below, and URLs never get a trailing slash added.

Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Force HTTPS (Cloudflare-aware, same logic as the main site)
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Never cache API responses in LiteSpeed
<IfModule LiteSpeed>
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# Pass the Authorization header through to PHP (MCP bearer tokens, OAuth client Basic auth).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Everything that isn't a real file goes through index.php. (Checking -f rather than the URI
# avoids a rewrite loop: after the internal rewrite REQUEST_URI still holds the original path.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cache-Control "no-store"
    Header always unset Content-Security-Policy
    # style-src/form-action are for the MCP sign-in page (/oauth/authorize): it has inline styles and
    # its Allow button redirects back to the AI app (Chrome applies form-action to that redirect).
    Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; form-action 'self' https: http://localhost:* http://127.0.0.1:*; frame-ancestors 'none'"
</IfModule>
